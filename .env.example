# Copy to `.env` (which is git-ignored) and fill in what you have.
# EVERY notebook in this repo runs fully offline without any of these. Keys only switch on the
# LLM-dependent cells: synthetic query generation (3.4), listwise reranking (8.2), grounded
# generation and the LLM-as-judge (9.3-9.4).

# Claude - the default LLM layer for the derived lab notebook.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI - only needed if you work the original interview notebook as written.
OPENAI_API_KEY=

# Optional: a Hugging Face token silences the unauthenticated-download warning and raises the
# model-download rate limit. Not required.
HF_TOKEN=
